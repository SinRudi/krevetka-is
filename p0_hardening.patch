+        ('orders', 'bonus_refunded', 'bonus_refunded INTEGER DEFAULT 0'),
+        ('shifts', 'cash_ops', 'cash_ops INTEGER DEFAULT 0'),
+    ]
+    for table, col, ddl in additions:
+        if col not in columns(table):
+            db.execute(f"ALTER TABLE {table} ADD COLUMN {ddl}")
