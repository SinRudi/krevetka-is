 #!/bin/bash
-# Скрипт резервного копирования базы данных Креветки
-DB_PATH="$HOME/my-apps/sushi_pos/sushi.db"
-BACKUP_DIR="$HOME/my-apps/sushi_pos/backups"
-DATE=$(date +"%Y-%m-%d_%H-%M-%S")
-DEST="$BACKUP_DIR/sushi_$DATE.db"
+# WAL-safe backup of the sushi POS database.
+# Usage: ./backup.sh [db_path] [backup_dir]
+set -euo pipefail
+
+APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+DB_PATH="${1:-${SUSHI_DB:-$APP_DIR/sushi.db}}"
+BACKUP_DIR="${2:-${SUSHI_BACKUP_DIR:-$APP_DIR/backups}}"
+KEEP_DAYS="${SUSHI_BACKUP_DAYS:-30}"
+
+if [ ! -f "$DB_PATH" ]; then
+    echo "Database not found: $DB_PATH" >&2
+    exit 1
+fi
 
-# Создаем папку, если ее нет
 mkdir -p "$BACKUP_DIR"
+chmod 700 "$BACKUP_DIR" 2>/dev/null || true
+
+STAMP="$(date +%Y-%m-%d_%H-%M-%S)"
+DEST="$BACKUP_DIR/sushi_$STAMP.db"
+
+# sqlite3 .backup is safe with WAL and concurrent writers.
+if command -v sqlite3 >/dev/null 2>&1; then
+    sqlite3 "$DB_PATH" ".timeout 10000" ".backup '$DEST'"
+else
+    python3 - "$DB_PATH" "$DEST" <<'PY'
+import sqlite3
+import sys
+
+src = sqlite3.connect(sys.argv[1], timeout=10)
+dst = sqlite3.connect(sys.argv[2])
+try:
+    with dst:
+        src.backup(dst)
+finally:
+    dst.close()
+    src.close()
+PY
+fi
 
-# Копируем базу
-cp "$DB_PATH" "$DEST"
+gzip -9 "$DEST"
+chmod 600 "$DEST.gz" 2>/dev/null || true
 
-# Удаляем бэкапы старше 30 дней, чтобы не забивать диск
-find "$BACKUP_DIR" -type f -name "sushi_*.db" -mtime +30 -delete
+# Keep the last 30 days.
+find "$BACKUP_DIR" -type f -name 'sushi_*.db.gz' -mtime "+$KEEP_DAYS" -delete
 
-echo "Бэкап создан: $DEST"
+echo "Backup created: $DEST.gz"
