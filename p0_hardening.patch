+def rate_limit(key, limit, window_sec):
+    now = time.time()
+    with _rate_lock:
+        q = _rate_hits[key]
+        while q and q[0] < now - window_sec:
+            q.popleft()
+        if len(q) >= limit:
+            return False
+        q.append(now)
