@app.route('/chat')
@login_required()
def chat_view(): return render_template('chat.html')

@app.route('/api/chat/get')
@login_required()
def api_chat_get():
    db = get_db()
    db.execute("UPDATE messages SET is_read=1 WHERE sender_id != ?", (session['user_id'],)); db.commit()
    msgs = db.execute("SELECT * FROM messages ORDER BY id DESC LIMIT 50").fetchall()
    now = time.time(); currently_typing = [u for u, t in typing_users.items() if now - t < 3 and u != session['username']]
    return jsonify({"messages": [dict(m) for m in reversed(msgs)], "typing": currently_typing})

@app.route('/api/chat/send', methods=['POST'])
@login_required()
def api_chat_send():
    data = request.json or {}; text = data.get('text', '').strip()
    if text:
        db = get_db()
        db.execute("INSERT INTO messages (sender_id, sender_name, text, created_at, is_read) VALUES (?,?,?,?,0)", (session['user_id'], session['username'], text, datetime.now().strftime("%H:%M")))
        db.commit()
        if session['username'] in typing_users: del typing_users[session['username']]
    return jsonify({"success": True})

@app.route('/api/chat/typing', methods=['POST'])
@login_required()
def api_chat_typing():
    typing_users[session['username']] = time.time(); return jsonify({"success": True})

