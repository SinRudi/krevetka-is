@app.route('/rate/<int:order_id>', methods=['GET', 'POST'])
def rate_order(order_id):
    db = get_db()
    if request.method == 'POST':
        db.execute("UPDATE orders SET rating=?, review_text=? WHERE id=?", (int(request.form.get('rating', 5)), request.form.get('review_text', ''), order_id)); db.commit()
        return "<h1 style='text-align:center; color:#30d158; font-family:sans-serif; margin-top:50px'>Спасибо за отзыв!</h1>"
    return render_template('rate.html', order=db.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone() or abort(404))

@app.route('/site')
def public_site():
    db = get_db()
    return render_template('public_site.html', menu=db.execute("SELECT * FROM menu WHERE available=1 ORDER BY sort_weight DESC, category, name").fetchall(), categories=db.execute("SELECT DISTINCT category FROM menu WHERE available=1 ORDER BY category").fetchall(), shop_open=is_shop_open(), banners=db.execute("SELECT * FROM banners ORDER BY id DESC").fetchall())

def deduct_ingredients(items):
    db = get_db(); total_cost = 0
    for i in items:
        for r in db.execute("SELECT r.ingredient_id, r.amount, i.name, i.stock, i.cost_price FROM recipes r JOIN ingredients i ON r.ingredient_id = i.id WHERE r.menu_id=?", (i.get('id'),)).fetchall():
            needed = r['amount'] * int(i.get('qty', 1))
            if r['stock'] < needed: return f"Нет в наличии: {r['name']} (нужно {needed}, есть {r['stock']})", 0
            db.execute("UPDATE ingredients SET stock = stock - ? WHERE id=?", (needed, r['ingredient_id'])); total_cost += (r['cost_price'] * needed)
    return None, total_cost

@app.route('/api/public_order', methods=['POST'])
def public_order():
    if not is_shop_open(): return jsonify({"error": "Мы работаем с 10:00 до 21:30."}), 400
    data = request.json or {}; items = data.get('items', [])
    if not items: return jsonify({"error": "Пустой заказ"}), 400
    db = get_db(); err, total_cost = deduct_ingredients(items)
    if err: return jsonify({"error": err}), 400
    shift = get_open_shift(); shift_id = shift['id'] if shift else 1
    subtotal = sum(int(i['price']) * int(i.get('qty', 1)) for i in items)
    promo_code = data.get('promo_code', '').strip().upper(); promo_discount = 0
    if promo_code:
        promo = db.execute("SELECT * FROM promocodes WHERE code=? AND is_active=1", (promo_code,)).fetchone()
        if promo: promo_discount = (subtotal * promo['discount_value']) // 100 if promo['discount_type'] == 'percent' else promo['discount_value']
    total = max(0, subtotal - promo_discount); phone = data.get('phone', ''); address = data.get('address', '')
    pay_method = data.get('payment_method', 'не указан'); change_from = int(data.get('change_from', 0))
    delivery_type = data.get('delivery_type', 'доставка')
    if delivery_type == 'самовывоз': address = 'Самовывоз'

    cur = db.execute("INSERT INTO orders (created_at, status, total, cost, address, phone, comment, shift_id, payment_method, change_from, delivery_type, promo_code, source) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)", (datetime.now().strftime("%Y-%m-%d %H:%M:%S"), 'new', total, total_cost, address, phone, data.get('comment', ''), shift_id, pay_method, change_from, delivery_type, promo_code, 'Сайт'))
    order_id = cur.lastrowid
    for i in items: db.execute("INSERT INTO order_items (order_id, menu_id, name, price, qty, modifiers) VALUES (?,?,?,?,?,?)", (order_id, i.get('id'), i['name'], int(i['price']), int(i.get('qty', 1)), i.get('mods', '')))
    if phone:
        client = db.execute("SELECT * FROM clients WHERE phone=?", (phone,)).fetchone()
        new_total_spent = (client['total_spent'] if client else 0) + total
        new_level = 'gold' if new_total_spent >= 30000 else ('silver' if new_total_spent >= 10000 else 'bronze')
        cashback_rate = 0.10 if new_level == 'gold' else (0.07 if new_level == 'silver' else 0.05)
        db.execute("""INSERT INTO clients (phone, total_spent, orders_count, last_order_at, level, bonuses) VALUES (?,?,?,?,?,?) ON CONFLICT(phone) DO UPDATE SET total_spent=total_spent+?, orders_count=orders_count+1, last_order_at=?, level=?, bonuses=bonuses+?""", (phone, total, 1, datetime.now().strftime("%Y-%m-%d %H:%M:%S"), new_level, int(total * cashback_rate), total, datetime.now().strftime("%Y-%m-%d %H:%M:%S"), new_level, int(total * cashback_rate)))
    db.commit(); return jsonify({"success": True, "order_id": order_id})

@app.route('/api/site/client/<phone>')
def site_client(phone):
    order = get_db().execute("SELECT * FROM orders WHERE phone=? ORDER BY id DESC LIMIT 1", (phone,)).fetchone()
    if order: return jsonify({"success": True, "address": order['address'], "last_order": [dict(i) for i in get_db().execute("SELECT * FROM order_items WHERE order_id=?", (order['id'],)).fetchall()]})
    return jsonify({"success": False})

@app.route('/api/client/<phone>')
def api_client(phone):
    client = get_db().execute("SELECT * FROM clients WHERE phone=?", (phone,)).fetchone()
    if client: return jsonify({"success": True, "bonuses": client['bonuses'], "level": client['level']})
    return jsonify({"success": False})

@app.route('/api/create_order', methods=['POST'])
@login_required('admin', 'cashier')
def create_order():
    if not is_shop_open(): return jsonify({"error": "Прием заказов приостановлен (10:00-21:30)."}), 400
    data = request.json or {}; items = data.get('items', [])
    if not items: return jsonify({"error": "Пустой заказ"}), 400
    db = get_db(); err, total_cost = deduct_ingredients(items)
    if err: return jsonify({"error": err}), 400
    shift = get_open_shift()
    if not shift: return jsonify({"error": "Смена не открыта"}), 400
    phone = data.get('phone', ''); address = data.get('address', ''); subtotal = sum(int(i['price']) * int(i.get('qty', 1)) for i in items)
    manual_discount = (subtotal * int(data.get('discount', 0)) // 100) if data.get('discount_type') == 'percent' else int(data.get('discount', 0))
    promo_code = data.get('promo_code', '').strip().upper(); promo_discount = 0
    if promo_code:
        promo = db.execute("SELECT * FROM promocodes WHERE code=? AND is_active=1", (promo_code,)).fetchone()
        if promo: promo_discount = (subtotal * promo['discount_value']) // 100 if promo['discount_type'] == 'percent' else promo['discount_value']
    total = max(0, subtotal - manual_discount - promo_discount)
    use_bonus = int(data.get('use_bonus', 0))
    if use_bonus > 0:
        client = db.execute("SELECT * FROM clients WHERE phone=?", (phone,)).fetchone()
        if client and client['bonuses'] >= use_bonus:
            total = max(0, total - use_bonus); db.execute("UPDATE clients SET bonuses = bonuses - ? WHERE phone=?", (use_bonus, phone))
    cur = db.execute("INSERT INTO orders (created_at, status, total, cost, address, phone, comment, shift_id, cashier_id, source, payment_method, delivery_type, delivery_zone, promo_code) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)", (datetime.now().strftime("%Y-%m-%d %H:%M:%S"), 'new', total, total_cost, address, phone, data.get('comment', ''), shift['id'], session['user_id'], 'Касса', data.get('payment_method', 'не указан'), data.get('delivery_type', 'доставка'), data.get('zone', ''), promo_code))
    order_id = cur.lastrowid
    for i in items: db.execute("INSERT INTO order_items (order_id, menu_id, name, price, qty, modifiers) VALUES (?,?,?,?,?,?)", (order_id, i.get('id'), i['name'], int(i['price']), int(i.get('qty', 1)), i.get('mods', '')))
    if phone:
        client = db.execute("SELECT * FROM clients WHERE phone=?", (phone,)).fetchone()
        new_total_spent = (client['total_spent'] if client else 0) + total
        new_level = 'gold' if new_total_spent >= 30000 else ('silver' if new_total_spent >= 10000 else 'bronze')
        cashback_rate = 0.10 if new_level == 'gold' else (0.07 if new_level == 'silver' else 0.05)
        db.execute("""INSERT INTO clients (phone, total_spent, orders_count, last_order_at, level, bonuses) VALUES (?,?,?,?,?,?) ON CONFLICT(phone) DO UPDATE SET total_spent=total_spent+?, orders_count=orders_count+1, last_order_at=?, level=?, bonuses=bonuses+?""", (phone, total, 1, datetime.now().strftime("%Y-%m-%d %H:%M:%S"), new_level, int(total * cashback_rate), total, datetime.now().strftime("%Y-%m-%d %H:%M:%S"), new_level, int(total * cashback_rate)))
    db.commit(); return jsonify({"success": True, "order_id": order_id, "total": total})

@app.route('/api/orders')
@login_required()
def api_orders():
    status = request.args.get('status'); db = get_db()
    if status:
        if status == 'active': rows = db.execute("SELECT * FROM orders WHERE status IN ('new', 'cooking') ORDER BY id").fetchall()
        elif status == 'all_active': rows = db.execute("SELECT * FROM orders WHERE status IN ('new', 'cooking', 'ready', 'delivering') ORDER BY id").fetchall()
        else: rows = db.execute("SELECT * FROM orders WHERE status=? ORDER BY id", (status,)).fetchall()
    else: rows = db.execute("SELECT * FROM orders ORDER BY id DESC").fetchall()
    result = [dict(r) | {"items": [dict(i) for i in db.execute("SELECT * FROM order_items WHERE order_id=?", (r['id'],)).fetchall()]} for r in rows]
    return jsonify(result)

@app.route('/api/set_status/<int:order_id>', methods=['POST'])
@login_required()
def set_status(order_id):
    data = request.json or {}; new_status = data.get('status'); db = get_db()
    try:
        if new_status == 'cancelled':
            items = db.execute("SELECT menu_id, qty FROM order_items WHERE order_id=?", (order_id,)).fetchall()
            for i in items:
                if i['menu_id']:
                    for r in db.execute("SELECT ingredient_id, amount FROM recipes WHERE menu_id=?", (i['menu_id'],)).fetchall():
                        db.execute("UPDATE ingredients SET stock = stock + ? WHERE id=?", (r['amount'] * i['qty'], r['ingredient_id']))
        if new_status == 'cooking': db.execute("UPDATE orders SET status=?, cook_start_time=? WHERE id=?", (new_status, datetime.now().strftime("%Y-%m-%d %H:%M:%S"), order_id))
        else: db.execute("UPDATE orders SET status=? WHERE id=?", (new_status, order_id))
        db.commit(); return jsonify({"success": True})
    except Exception as e: return jsonify({"error": str(e)}), 500

