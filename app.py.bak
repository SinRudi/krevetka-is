from flask import Flask, render_template, request, jsonify, g, session, redirect, url_for, flash, make_response, send_from_directory, send_file
from datetime import datetime, timedelta
from functools import wraps
from werkzeug.security import generate_password_hash, check_password_hash
import sqlite3, os, socket, uuid, io, openpyxl, time

app = Flask(__name__)
app.secret_key = os.environ.get('SUSHI_SECRET', 'super-secret-key-change-me')
DB_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'sushi.db')
UPLOAD_FOLDER = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'static', 'uploads')
app.config['UPLOAD_FOLDER'] = UPLOAD_FOLDER
os.makedirs(UPLOAD_FOLDER, exist_ok=True)

typing_users = {}

def get_db():
    if 'db' not in g:
        g.db = sqlite3.connect(DB_PATH)
        g.db.row_factory = sqlite3.Row
        g.db.execute("PRAGMA foreign_keys = ON")
    return g.db

@app.teardown_appcontext
def close_db(exception):
    db = g.pop('db', None)
    if db is not None: db.close()

@app.route('/manifest.json')
def manifest(): return send_from_directory(os.path.dirname(os.path.abspath(__file__)), 'manifest.json')
@app.route('/chat_manifest.json')
def chat_manifest(): return send_from_directory(os.path.dirname(os.path.abspath(__file__)), 'chat_manifest.json')
@app.route('/sw.js')
def service_worker(): return send_from_directory(os.path.dirname(os.path.abspath(__file__)), 'sw.js')

def get_setting(key):
    row = get_db().execute("SELECT value FROM settings WHERE key=?", (key,)).fetchone()
    return row['value'] if row else None

def set_setting(key, value):
    db = get_db()
    db.execute("INSERT INTO settings (key, value) VALUES (?,?) ON CONFLICT(key) DO UPDATE SET value=?", (key, value, value))
    db.commit()

def is_shop_open():
    status = get_setting('shop_status') or 'auto'
    if status == 'closed': return False
    if status == 'open': return True
    now = datetime.now().time()
    return datetime.strptime("10:00", "%H:%M").time() <= now <= datetime.strptime("21:30", "%H:%M").time()

def init_db():
    db = sqlite3.connect(DB_PATH)
    db.executescript("""
    CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT);
    CREATE TABLE IF NOT EXISTS banners (id INTEGER PRIMARY KEY AUTOINCREMENT, image TEXT NOT NULL, title TEXT);
    CREATE TABLE IF NOT EXISTS messages (id INTEGER PRIMARY KEY AUTOINCREMENT, sender_id INTEGER, sender_name TEXT, text TEXT, created_at TEXT, is_read INTEGER DEFAULT 0);
    CREATE TABLE IF NOT EXISTS courier_locations (courier_id INTEGER PRIMARY KEY, lat REAL, lng REAL, updated_at TEXT);
    CREATE TABLE IF NOT EXISTS menu (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, price INTEGER NOT NULL, category TEXT NOT NULL, available INTEGER NOT NULL DEFAULT 1, stop_list INTEGER DEFAULT 0, image TEXT DEFAULT '', composition TEXT DEFAULT '', modifiers TEXT DEFAULT '', sort_weight INTEGER DEFAULT 0);
    CREATE TABLE IF NOT EXISTS orders (id INTEGER PRIMARY KEY AUTOINCREMENT, created_at TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'new', total INTEGER NOT NULL, cost REAL DEFAULT 0, address TEXT, phone TEXT, comment TEXT, shift_id INTEGER, cashier_id INTEGER DEFAULT 0, source TEXT DEFAULT 'Касса', payment_method TEXT DEFAULT 'не указан', payment_cash INTEGER DEFAULT 0, payment_card INTEGER DEFAULT 0, change_from INTEGER DEFAULT 0, delivery_type TEXT DEFAULT 'доставка', scheduled_time TEXT, cancel_reason TEXT DEFAULT '', courier_name TEXT DEFAULT '', discount INTEGER DEFAULT 0, discount_type TEXT DEFAULT 'rub', delivery_zone TEXT DEFAULT '', cook_start_time TEXT, cook_end_time TEXT, promo_code TEXT DEFAULT '', rating INTEGER DEFAULT 0, review_text TEXT DEFAULT '');
    CREATE TABLE IF NOT EXISTS order_items (id INTEGER PRIMARY KEY AUTOINCREMENT, order_id INTEGER NOT NULL, menu_id INTEGER, name TEXT NOT NULL, price INTEGER NOT NULL, qty INTEGER NOT NULL DEFAULT 1, modifiers TEXT DEFAULT '', FOREIGN KEY(order_id) REFERENCES orders(id) ON DELETE CASCADE);
    CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT UNIQUE NOT NULL, password_hash TEXT NOT NULL, role TEXT NOT NULL DEFAULT 'cashier', created_at TEXT NOT NULL);
    CREATE TABLE IF NOT EXISTS shifts (id INTEGER PRIMARY KEY AUTOINCREMENT, opened_at TEXT NOT NULL, closed_at TEXT, opened_by INTEGER, closed_by INTEGER, total_orders INTEGER DEFAULT 0, total_revenue INTEGER DEFAULT 0, status TEXT NOT NULL DEFAULT 'open', total_cash INTEGER DEFAULT 0, total_card INTEGER DEFAULT 0);
    CREATE TABLE IF NOT EXISTS clients (id INTEGER PRIMARY KEY AUTOINCREMENT, phone TEXT UNIQUE NOT NULL, name TEXT, bonuses INTEGER DEFAULT 0, total_spent INTEGER DEFAULT 0, orders_count INTEGER DEFAULT 0, last_order_at TEXT, level TEXT DEFAULT 'bronze');
    CREATE TABLE IF NOT EXISTS zones (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, price INTEGER NOT NULL, polygon_data TEXT DEFAULT '');
    CREATE TABLE IF NOT EXISTS promocodes (id INTEGER PRIMARY KEY AUTOINCREMENT, code TEXT UNIQUE NOT NULL, discount_type TEXT NOT NULL DEFAULT 'percent', discount_value INTEGER NOT NULL, is_active INTEGER DEFAULT 1);
    CREATE TABLE IF NOT EXISTS ingredients (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, stock REAL DEFAULT 0, unit TEXT NOT NULL, cost_price REAL DEFAULT 0);
    CREATE TABLE IF NOT EXISTS recipes (menu_id INTEGER, ingredient_id INTEGER, amount REAL NOT NULL, PRIMARY KEY (menu_id, ingredient_id), FOREIGN KEY(menu_id) REFERENCES menu(id) ON DELETE CASCADE, FOREIGN KEY(ingredient_id) REFERENCES ingredients(id) ON DELETE CASCADE);
    """)
    
    if db.execute("SELECT COUNT(*) FROM settings").fetchone()[0] == 0: db.execute("INSERT INTO settings (key, value) VALUES ('shop_status', 'auto')")
    if db.execute("SELECT COUNT(*) FROM users").fetchone()[0] == 0:
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        db.executemany("INSERT INTO users (username, password_hash, role, created_at) VALUES (?,?,?,?)", [
            ("admin", generate_password_hash("admin"), "admin", now), ("cashier", generate_password_hash("cashier"), "cashier", now),
            ("kitchen", generate_password_hash("kitchen"), "kitchen", now), ("courier", generate_password_hash("courier"), "courier", now),
        ])
    if db.execute("SELECT COUNT(*) FROM promocodes").fetchone()[0] == 0: db.execute("INSERT INTO promocodes (code, discount_type, discount_value) VALUES (?,?,?)", ("SUSHI10", "percent", 10))
    db.commit(); db.close()

def login_required(*roles):
    def decorator(f):
        @wraps(f)
        def wrapper(*args, **kwargs):
            if 'user_id' not in session: return redirect(url_for('login'))
            if roles and session.get('role') not in roles: return "Доступ запрещён", 403
            return f(*args, **kwargs)
        return wrapper
    return decorator

@app.route('/login', methods=['GET', 'POST'])
def login():
    if request.method == 'POST':
        user = get_db().execute("SELECT * FROM users WHERE username=?", (request.form.get('username', '').strip(),)).fetchone()
        if user and check_password_hash(user['password_hash'], request.form.get('password', '')):
            session.clear(); session['user_id'] = user['id']; session['username'] = user['username']; session['role'] = user['role']
            return redirect(url_for('index'))
        flash('Неверный логин или пароль')
    return render_template('login.html')

@app.route('/logout')
def logout(): session.clear(); return redirect(url_for('login'))

def get_open_shift(): return get_db().execute("SELECT * FROM shifts WHERE status='open' ORDER BY id DESC LIMIT 1").fetchone()

@app.route('/shift/open', methods=['POST'])
@login_required('admin', 'cashier')
def shift_open():
    if get_open_shift(): return redirect(url_for('index'))
    get_db().execute("INSERT INTO shifts (opened_at, opened_by, status) VALUES (?,?,?)", (datetime.now().strftime("%Y-%m-%d %H:%M:%S"), session['user_id'], 'open'))
    get_db().commit(); return redirect(url_for('index'))

@app.route('/shift/close', methods=['POST'])
@login_required('admin', 'cashier')
def shift_close():
    shift = get_open_shift()
    if not shift: return redirect(url_for('index'))
    db = get_db()
    row = db.execute("SELECT COUNT(*) cnt, COALESCE(SUM(total),0) rev, COALESCE(SUM(payment_cash),0) cash, COALESCE(SUM(payment_card),0) card FROM orders WHERE shift_id=? AND status!='cancelled'", (shift['id'],)).fetchone()
    db.execute("UPDATE shifts SET closed_at=?, closed_by=?, status='closed', total_orders=?, total_revenue=?, total_cash=?, total_card=? WHERE id=?", (datetime.now().strftime("%Y-%m-%d %H:%M:%S"), session['user_id'], row['cnt'], row['rev'], row['cash'], row['card'], shift['id']))
    db.commit(); return redirect(url_for('reports'))

@app.route('/')
@login_required()
def index():
    if session['role'] == 'kitchen': return redirect(url_for('kitchen'))
    if session['role'] == 'courier': return redirect(url_for('courier'))
    db = get_db()
    return render_template('cashier.html', menu=db.execute("SELECT * FROM menu WHERE available=1 ORDER BY sort_weight DESC, category, name").fetchall(), categories=db.execute("SELECT DISTINCT category FROM menu WHERE available=1 ORDER BY category").fetchall(), zones=db.execute("SELECT * FROM zones").fetchall(), shift=get_open_shift(), role=session['role'], shop_open=is_shop_open())

