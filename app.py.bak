@app.route('/api/order/update_items/<int:order_id>', methods=['POST'])
@login_required('admin', 'cashier')
def update_order_items(order_id):
    data = request.json or {}
    new_items = data.get('items', [])
    if not new_items: return jsonify({"error": "В заказе должна остаться хотя бы одна позиция"}), 400
    db = get_db()
    order = db.execute("SELECT * FROM orders WHERE id=?", (order_id,)).fetchone()
    if not order: return jsonify({"error": "Заказ не найден"}), 404
    if order['status'] in ('done', 'cancelled'): return jsonify({"error": "Нельзя редактировать закрытый заказ"}), 400
    old_items = db.execute("SELECT menu_id, qty FROM order_items WHERE order_id=?", (order_id,)).fetchall()
    for oi in old_items:
        if oi['menu_id']:
            for r in db.execute("SELECT ingredient_id, amount FROM recipes WHERE menu_id=?", (oi['menu_id'],)).fetchall():
                db.execute("UPDATE ingredients SET stock = stock + ? WHERE id=?", (r['amount'] * oi['qty'], r['ingredient_id']))
    err, new_cost = deduct_ingredients(new_items)
    if err: return jsonify({"error": err}), 400
    db.execute("DELETE FROM order_items WHERE order_id=?", (order_id,))
    new_total = 0
    for i in new_items:
        qty = int(i.get('qty', 1))
        price = int(i['price'])
        new_total += price * qty
        db.execute("INSERT INTO order_items (order_id, menu_id, name, price, qty, modifiers) VALUES (?,?,?,?,?,?)", (order_id, i.get('id'), i['name'], price, qty, i.get('mods', '')))
    db.execute("UPDATE orders SET total=?, cost=? WHERE id=?", (new_total, new_cost, order_id))
    db.commit()
    return jsonify({"success": True, "new_total": new_total})

@app.route('/api/all_orders')
@login_required()
def api_all_orders():
    db = get_db()
    date_filter = request.args.get('date', datetime.now().strftime("%Y-%m-%d"))
    cashier_id = request.args.get('cashier_id'); source = request.args.get('source'); status = request.args.get('status')
    query = "SELECT o.*, u.username as cashier_name FROM orders o LEFT JOIN users u ON o.cashier_id = u.id WHERE 1=1"
    params = []
    if date_filter: query += " AND date(o.created_at) = ?"; params.append(date_filter)
    if cashier_id: query += " AND o.cashier_id = ?"; params.append(cashier_id)
    if source: query += " AND o.source = ?"; params.append(source)
    if status: query += " AND o.status = ?"; params.append(status)
    query += " ORDER BY o.id DESC"
    rows = db.execute(query, params).fetchall()
    result = []; total_sum = 0
    for r in rows:
        order = dict(r); order['items'] = [dict(i) for i in db.execute("SELECT * FROM order_items WHERE order_id=?", (r['id'],)).fetchall()]; result.append(order)
        if order['status'] != 'cancelled': total_sum += order['total']
    return jsonify({"orders": result, "stats": {"count": len([o for o in result if o['status'] != 'cancelled']), "total": total_sum, "avg": round(total_sum / len([o for o in result if o['status'] != 'cancelled'])) if total_sum > 0 else 0}})

