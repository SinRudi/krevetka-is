@app.route('/analytics')
@login_required('admin')
def analytics_panel():
    db = get_db(); stats = db.execute("SELECT SUM(total) as rev, SUM(cost) as cost FROM orders WHERE status != 'cancelled'").fetchone()
    total_rev = stats['rev'] or 0; total_cost = stats['cost'] or 0; total_profit = total_rev - total_cost
